{
  "name": "always-on-local-note-taker",
  "version": "0.1.0",
  "private": true,
  "description": "Granola-style always-on meeting note taker for macOS, local-by-default",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbijahKaj/notetaker.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "models:download": "tsx scripts/download-models.ts --required-only",
    "sidecar:build": "bash scripts/build-sidecar.sh"
  },
  "devDependencies": {
    "@notetaker/core": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
