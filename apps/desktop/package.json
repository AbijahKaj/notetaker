{
  "name": "desktop",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/AbijahKaj/notetaker",
  "author": "Abijah Kajabika",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "package:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^11.10.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^1.13.2"
  },
  "devDependencies": {
    "@notetaker/audio-bridge": "workspace:*",
    "@notetaker/core": "workspace:*",
    "@notetaker/llm": "workspace:*",
    "@notetaker/speech": "workspace:*",
    "@notetaker/storage": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
